{  "title": "JSON Schema for Web API 1.0.0",  "Description": "Validate a UploadDynamicVocabulary request",  "$schema": "http://json-schema.org/draft-04/schema#",  "type": "object",  "required": [    "type",    "command"  ],  "properties": {    "type": {      "type": "string",      "pattern": "^command$"    },    "sessionId": {      "type": "string"    },    "metadata": {      "type": "object"    },    "command": {      "$ref": "#/definitions/uploadDynamicVocabularyCommand"    }  },  "additionalProperties": false,  "definitions": {    "uploadDynamicVocabularyCommand": {      "required": [        "name",        "id"      ],      "properties": {        "name": {          "type": "string",          "pattern": "^uploadDynamicVocabulary$"        },        "id": {          "type": "string"        },        "parameters": {          "$ref": "#/definitions/uploadDynamicVocabularyParameters"        }      },      "additionalProperties": false    },    "uploadDynamicVocabularyParameters": {      "type": "object",      "required": [        "dynamicVocabularies"      ],      "properties": {        "sessionParameters": {          "$ref": "SessionlessSchema.json#"        },        "dynamicVocabularies": {          "type": "array",          "items": {            "type": "object"          },          "minItems": 1,          "uniqueItems": true        },        "statistics": {          "type": "boolean"        },        "sensitivity": {          "enum": [            "encrypted",            "masked",            "open"          ]        }      },      "additionalProperties": false    }  }}