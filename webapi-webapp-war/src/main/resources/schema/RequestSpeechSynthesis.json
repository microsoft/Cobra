{  "title": "JSON Schema for Web API 1.0.0",  "description": "Validate a speech synthesis request",  "$schema": "http://json-schema.org/draft-04/schema#",  "type": "object",  "required": [    "type",    "command"  ],  "properties": {    "version": {      "type": "string"    },    "type": {      "type": "string",      "pattern": "^command$"    },    "sessionId": {      "type": "string"    },    "metadata": {      "type": "object"    },    "command": {      "$ref": "#/definitions/speechSynthesisCommand"    }  },  "additionalProperties": false,  "definitions": {    "speechSynthesisCommand": {      "required": [        "name",        "id",        "parameters"      ],      "properties": {        "name": {          "type": "string",          "pattern": "^speechSynthesis$"        },        "id": {          "type": "string",          "minLength": 1        },        "parameters": {          "$ref": "#/definitions/speechSynthesisParameters"        }      },      "additionalProperties": false    },    "speechSynthesisParameters": {      "type": "object",      "required": [        "data"      ],      "properties": {        "sessionParameters": {          "$ref": "SessionlessSchema.json#"        },        "data": {          "type": "string",          "maxLength": 64512,          "minLength": 1        },        "type": {          "enum": [            "text",            "ssml"          ]        },        "language": {          "type": "string"        },        "speechSynthesisRate": {          "type": "string"        },        "speechSynthesisTuningBundle": {          "type": "string"        },        "voice": {          "type": "string",          "minLength": 1        },        "speechSynthesisCodec": {          "$ref": "SessionlessSchema.json#/properties/speechSynthesisCodec"        },        "statistics": {          "type": "boolean"        },        "sensitivity": {          "enum": [            "encrypted",            "masked",            "open"          ]        }      },      "additionalProperties": false    }  }}