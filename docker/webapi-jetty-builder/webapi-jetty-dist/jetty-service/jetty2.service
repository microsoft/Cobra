[Unit]
Description=Nuance WebAPI Jetty2
After=syslog.target network.target

[Service]
Type=forking
User=njetty
ExecStart=/etc/init.d/jetty2 start
ExecStop=/etc/init.d/jetty2 stop
SuccessExitStatus=130 143
LimitNOFILE=65536
Restart=on-failure
Environment=LAUNCHED_BY_SYSTEMD=1

[Install]
WantedBy=default.target
