<?xml version="1.0" encoding="UTF-8"?>

<web-app version="3.0">
   <display-name>ncs-nmsp-http-servlet</display-name>

   <!-- Catch all the error codes and exceptions -->
   <error-page>  
     <location>/error.html</location>  
   </error-page> 

   <servlet>
      <servlet-name>NmspServlet</servlet-name>
      <servlet-class>com.nuance.ncs.nmsp.servlet.NcsServlet</servlet-class>
   </servlet>
   <servlet-mapping>
      <servlet-name>NmspServlet</servlet-name>
      <url-pattern>/*</url-pattern>
   </servlet-mapping>

</web-app>
